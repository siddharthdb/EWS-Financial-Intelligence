{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ews-financial-intelligence/schemas/identity/entity-resolution-v1.schema.json",
  "title": "EWS Entity Resolution Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolutionId", "sourceEntity", "status", "method", "confidence", "knowledgeTime"],
  "properties": {
    "resolutionId": {"type": "string", "minLength": 1},
    "sourceEntity": {
      "type": "object", "additionalProperties": false, "required": ["sourceId", "sourceEntityId"],
      "properties": {
        "sourceId": {"type": "string"},
        "sourceEntityId": {"type": "string"},
        "name": {"type": ["string", "null"]},
        "jurisdiction": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
        "identifiers": {"type": "array", "items": {"type": "object", "required": ["type", "value"], "properties": {"type": {"type": "string"}, "value": {"type": "string"}, "issuer": {"type": ["string", "null"]}}}}
      }
    },
    "canonicalEntity": {
      "type": ["object", "null"],
      "properties": {"type": {"type": "string"}, "id": {"type": "string"}}
    },
    "status": {"type": "string", "enum": ["MATCHED", "AMBIGUOUS", "UNMATCHED", "REJECTED", "SUPERSEDED"]},
    "method": {"type": "string", "enum": ["AUTHORITATIVE_IDENTIFIER", "DETERMINISTIC_MULTI_ATTRIBUTE", "PROBABILISTIC", "GRAPH_ASSISTED", "MANUAL"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "matchedAttributes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "conflictingAttributes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "candidateEntityIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "modelOrRuleRef": {"type": ["string", "null"]},
    "humanDecisionRef": {"type": ["string", "null"]},
    "effectiveAt": {"type": ["string", "null"], "format": "date-time"},
    "knowledgeTime": {"type": "string", "format": "date-time"},
    "supersedesResolutionId": {"type": ["string", "null"]},
    "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}