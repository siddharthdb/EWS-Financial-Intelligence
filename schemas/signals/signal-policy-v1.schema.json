{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ews-financial-intelligence/schemas/signals/signal-policy-v1.schema.json",
  "title": "EWS Global Signal Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyId", "signalType", "semanticScope", "version", "status", "applicability", "detection", "effectiveFrom", "approval"],
  "properties": {
    "policyId": {"type": "string", "minLength": 1},
    "signalType": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "semanticScope": {"type": "string", "enum": ["GLOBAL_CORE", "GLOBAL_PRODUCT_SPECIFIC", "JURISDICTION_EXTENSION", "INSTITUTION_POLICY_SPECIFIC"]},
    "version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["DRAFT", "VALIDATION", "APPROVED", "ACTIVE", "RETIRED"]},
    "applicability": {
      "type": "object", "additionalProperties": false, "required": ["domain"],
      "properties": {
        "domain": {"type": "string", "enum": ["CORPORATE", "RETAIL"]},
        "institutions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "legalEntities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "jurisdictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "markets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "segments": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "products": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "currencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{3}$"}}
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "features": {"type": "array", "items": {"type": "string"}},
        "eventTypes": {"type": "array", "items": {"type": "string"}},
        "minimumEvidenceTier": {"type": "string", "enum": ["T1", "T2", "T3", "T4"]},
        "minimumCorroborationCount": {"type": "integer", "minimum": 0},
        "requiresEntityResolution": {"type": "boolean"},
        "minimumEntityMatchConfidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "requiredSourceRights": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["RISK_ANALYTICS", "LLM_PROCESSING", "MODEL_INFERENCE", "MODEL_TRAINING", "RAW_RETENTION", "DERIVED_RETENTION"]}}
      }
    },
    "detection": {
      "type": "object", "additionalProperties": false, "required": ["method"],
      "properties": {
        "method": {"type": "string", "enum": ["RULE", "STATISTICAL", "ANOMALY", "ML", "GRAPH", "NLP", "HYBRID"]},
        "window": {"type": ["string", "null"]},
        "condition": {"type": ["object", "array", "string"]},
        "modelRef": {"type": ["string", "null"]},
        "peerCohortRef": {"type": ["string", "null"]},
        "marketNormalizationRef": {"type": ["string", "null"]}
      }
    },
    "modelUse": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "permittedUses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "prohibitedUses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "validationRef": {"type": ["string", "null"]},
        "calibrationRef": {"type": ["string", "null"]},
        "populationRef": {"type": ["string", "null"]}
      }
    },
    "severityMapping": {"type": "object"},
    "confidencePolicy": {"type": "object"},
    "materialityPolicy": {"type": "object"},
    "qualityGate": {"type": "object"},
    "deduplication": {"type": "object"},
    "suppression": {"type": "object"},
    "cooldown": {"type": ["string", "null"]},
    "decay": {"type": ["object", "null"]},
    "humanValidationRequired": {"type": "boolean"},
    "riskContributionPolicyRef": {"type": ["string", "null"]},
    "classificationContributionRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "effectiveFrom": {"type": "string", "format": "date-time"},
    "effectiveTo": {"type": ["string", "null"], "format": "date-time"},
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["owner"],
      "properties": {
        "owner": {"type": "string"},
        "approvedBy": {"type": ["string", "null"]},
        "approvedAt": {"type": ["string", "null"], "format": "date-time"},
        "validationRef": {"type": ["string", "null"]}
      }
    }
  }
}