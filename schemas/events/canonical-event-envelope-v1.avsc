{
  "type": "record",
  "name": "CanonicalEventEnvelopeV1",
  "namespace": "in.ews.events.v1",
  "doc": "Common EWS event metadata. Domain payload schemas are separate governed records and are composed/wrapped by producer-specific event schemas.",
  "fields": [
    {
      "name": "eventId",
      "type": {"type": "string", "logicalType": "uuid"},
      "doc": "Immutable identity of the committed business event; unchanged across publication retries."
    },
    {"name": "eventType", "type": "string"},
    {"name": "eventVersion", "type": "string"},
    {
      "name": "producer",
      "type": {
        "type": "record",
        "name": "ProducerIdentityV1",
        "fields": [
          {"name": "service", "type": "string"},
          {"name": "instance", "type": ["null", "string"], "default": null},
          {"name": "version", "type": ["null", "string"], "default": null}
        ]
      }
    },
    {
      "name": "entity",
      "type": {
        "type": "record",
        "name": "EntityReferenceV1",
        "fields": [
          {"name": "type", "type": "string"},
          {"name": "id", "type": "string"}
        ]
      }
    },
    {"name": "aggregateSequence", "type": ["null", "long"], "default": null},
    {"name": "partitionKey", "type": "string"},
    {"name": "eventTime", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "effectiveTime", "type": ["null", {"type": "long", "logicalType": "timestamp-micros"}], "default": null},
    {"name": "knowledgeTime", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "ingestedAt", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {
      "name": "source",
      "type": {
        "type": "record",
        "name": "SourceReferenceV1",
        "fields": [
          {"name": "system", "type": "string"},
          {"name": "recordId", "type": ["null", "string"], "default": null},
          {"name": "evidenceIds", "type": {"type": "array", "items": "string"}, "default": []}
        ]
      }
    },
    {"name": "correlationId", "type": ["null", "string"], "default": null},
    {"name": "causationId", "type": ["null", "string"], "default": null},
    {"name": "traceId", "type": ["null", "string"], "default": null},
    {
      "name": "classification",
      "type": {
        "type": "record",
        "name": "DataClassificationV1",
        "fields": [
          {"name": "sensitivity", "type": {"type": "enum", "name": "SensitivityV1", "symbols": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]}},
          {"name": "containsPii", "type": "boolean", "default": false},
          {"name": "retentionClass", "type": ["null", "string"], "default": null}
        ]
      }
    },
    {
      "name": "execution",
      "type": {
        "type": "record",
        "name": "ExecutionMetadataV1",
        "fields": [
          {"name": "mode", "type": {"type": "enum", "name": "ExecutionModeV1", "symbols": ["LIVE", "RECOVERY_REPLAY", "PROJECTION_REBUILD", "FEATURE_REBUILD", "COUNTERFACTUAL_BACKTEST", "SOURCE_BACKFILL"]}, "default": "LIVE"},
          {"name": "runId", "type": ["null", "string"], "default": null}
        ]
      },
      "default": {"mode": "LIVE", "runId": null}
    }
  ]
}
