{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ews-financial-intelligence/schemas/risk-intelligence/correlation-hypothesis-v1.schema.json",
  "title": "EWS Correlation Hypothesis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesisId",
    "hypothesisType",
    "entity",
    "status",
    "policy",
    "executionMode",
    "knowledgeTime",
    "asOf",
    "contributors",
    "independentContributorCount",
    "evidenceIds",
    "confidence",
    "materiality",
    "revision",
    "createdAt"
  ],
  "properties": {
    "hypothesisId": {
      "type": "string",
      "minLength": 1
    },
    "hypothesisType": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COUNTERPARTY",
            "FACILITY",
            "ACCOUNT",
            "GROUP",
            "LEGAL_ENTITY",
            "RELATIONSHIP"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "REJECTED",
        "RESOLVED"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "LIVE",
        "RECOVERY_REPLAY",
        "PROJECTION_REBUILD",
        "FEATURE_REBUILD",
        "COUNTERFACTUAL_BACKTEST",
        "SOURCE_BACKFILL"
      ]
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "knowledgeTime": {
      "type": "string",
      "format": "date-time"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "analyticalType",
          "entity",
          "role",
          "effectiveAt",
          "knowledgeTime",
          "evidenceIds",
          "featureSnapshotIds"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SIGNAL",
              "EPISODE"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "analyticalType": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "entity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPPORTING",
              "CONTRADICTING",
              "CONTEXTUAL"
            ]
          },
          "effectiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "knowledgeTime": {
            "type": "string",
            "format": "date-time"
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "featureSnapshotIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "lineageGroupIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "contributionStrength": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "independentContributorCount": {
      "type": "integer",
      "minimum": 0
    },
    "lineageCollapse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawSupportingCount",
        "independentSupportingCount"
      ],
      "properties": {
        "rawSupportingCount": {
          "type": "integer",
          "minimum": 0
        },
        "independentSupportingCount": {
          "type": "integer",
          "minimum": 0
        },
        "collapsedLineageGroupIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "featureSnapshotIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "materiality": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "summaryRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previousRevisionRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "resolvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "RESOLVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "resolvedAt"
        ],
        "properties": {
          "resolvedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
