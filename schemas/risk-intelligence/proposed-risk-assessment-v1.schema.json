{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ews-financial-intelligence/schemas/risk-intelligence/proposed-risk-assessment-v1.schema.json",
  "title": "EWS Proposed Risk Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessmentId",
    "entity",
    "assessmentType",
    "asOf",
    "knowledgeTime",
    "executionMode",
    "runId",
    "aggregationPolicy",
    "dimensionAssessments",
    "overallAssessment",
    "signalIds",
    "episodeIds",
    "correlationHypothesisIds",
    "evidenceIds",
    "featureSnapshotIds",
    "contradictions",
    "qualitySummary",
    "revision",
    "previousRevisionRef",
    "createdAt"
  ],
  "properties": {
    "assessmentId": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COUNTERPARTY",
            "GROUP",
            "FACILITY",
            "ACCOUNT"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessmentType": {
      "const": "PROPOSED"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "knowledgeTime": {
      "type": "string",
      "format": "date-time"
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "LIVE",
        "RECOVERY_REPLAY",
        "PROJECTION_REBUILD",
        "FEATURE_REBUILD",
        "COUNTERFACTUAL_BACKTEST",
        "SOURCE_BACKFILL"
      ]
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "artifactHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifactHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dimensionAssessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "riskDimension",
          "proposedBand",
          "confidence",
          "materiality",
          "contributors",
          "capApplied"
        ],
        "properties": {
          "riskDimension": {
            "type": "string",
            "enum": [
              "LIQUIDITY",
              "LEVERAGE_SOLVENCY",
              "PROFITABILITY_OPERATING_PERFORMANCE",
              "CASH_FLOW_DEBT_SERVICE",
              "REPAYMENT_CONDUCT",
              "COVENANT_DOCUMENTATION",
              "COLLATERAL_SECURITY",
              "REFINANCING_FUNDING",
              "MANAGEMENT_GOVERNANCE",
              "FRAUD_INTEGRITY",
              "EXTERNAL_MARKET_REPUTATION",
              "LEGAL_REGULATORY",
              "RELATIONSHIP_GROUP_CONTAGION",
              "SECTOR_MACRO"
            ]
          },
          "rawScore": {
            "type": [
              "number",
              "null"
            ]
          },
          "scoreScaleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "proposedBand": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "materiality": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "contributors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id",
                "analyticalType",
                "contributionFamily",
                "role",
                "lineageGroupIds",
                "confidence",
                "materiality"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "SIGNAL",
                    "EPISODE",
                    "CORRELATION_HYPOTHESIS",
                    "MODEL_PREDICTION",
                    "STATISTICAL_ASSERTION"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "analyticalType": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]+$"
                },
                "contributionFamily": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]+$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "SCORING",
                    "LINEAGE_ONLY",
                    "CONTRADICTING",
                    "CONTEXTUAL"
                  ]
                },
                "lineageGroupIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "scoreContribution": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "bandContribution": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "LOW",
                    "MEDIUM",
                    "HIGH",
                    "CRITICAL",
                    null
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "materiality": {
                  "type": "string",
                  "enum": [
                    "LOW",
                    "MEDIUM",
                    "HIGH",
                    "CRITICAL"
                  ]
                }
              }
            }
          },
          "capApplied": {
            "type": "boolean"
          },
          "rationaleRef": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "overallAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "proposedBand",
        "confidence",
        "materiality",
        "requiresHumanReview"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "MAX_DIMENSION",
            "WEIGHTED_DIMENSIONS",
            "BAND_ONLY"
          ]
        },
        "rawScore": {
          "type": [
            "number",
            "null"
          ]
        },
        "scoreScaleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposedBand": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "materiality": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "requiresHumanReview": {
          "type": "boolean"
        }
      }
    },
    "signalIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "episodeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "correlationHypothesisIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "featureSnapshotIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summaryRef",
          "effect"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "summaryRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "effect": {
            "type": "string",
            "enum": [
              "CONFIDENCE_REDUCED",
              "HUMAN_REVIEW_REQUIRED",
              "BAND_TRANSITION_BLOCKED"
            ]
          }
        }
      }
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "excludedContributorIds"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "STALE",
            "CONFLICTED",
            "UNVERIFIED",
            "INSUFFICIENT"
          ]
        },
        "excludedContributorIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previousRevisionRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionMode": {
            "not": {
              "const": "LIVE"
            }
          }
        },
        "required": [
          "executionMode"
        ]
      },
      "then": {
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
