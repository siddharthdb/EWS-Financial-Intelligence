{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ews-financial-intelligence/schemas/policies/policy-evaluation-result-v1.schema.json",
  "title": "EWS Policy Evaluation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluationId",
    "policy",
    "entity",
    "status",
    "knowledgeTime",
    "executionMode",
    "engine",
    "evaluatedAt",
    "ruleResults"
  ],
  "properties": {
    "evaluationId": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "version"
      ],
      "properties": {
        "policyId": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "MATCHED",
        "NOT_MATCHED",
        "INSUFFICIENT_EVIDENCE",
        "FAILED"
      ]
    },
    "knowledgeTime": {
      "type": "string",
      "format": "date-time"
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "LIVE",
        "RECOVERY_REPLAY",
        "PROJECTION_REBUILD",
        "FEATURE_REBUILD",
        "COUNTERFACTUAL_BACKTEST",
        "SOURCE_BACKFILL"
      ]
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NATIVE",
            "DMN",
            "DROOLS"
          ]
        },
        "version": {
          "type": "string"
        },
        "artifactRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inputFeatureValueIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "ruleResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "matched"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "matched": {
            "type": "boolean"
          },
          "outcomeCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL",
              null
            ]
          },
          "evaluatedOperands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "FEATURE",
                    "PARAMETER",
                    "LITERAL"
                  ]
                }
              }
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "code",
          "ruleId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SIGNAL_CANDIDATE",
              "POLICY_FLAG",
              "CLASSIFICATION_CANDIDATE",
              "NO_ACTION"
            ]
          },
          "code": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "failure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
