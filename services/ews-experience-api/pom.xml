<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.ewsfi</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ews-experience-api</artifactId>
  <packaging>jar</packaging>
  <name>EWS Experience API</name>
  <description>
    Thin read API closing the human-validation loop's view side for the payment-return signal
    family, per docs/architecture/06-gap-analysis-and-implementation-roadmap.md Section 7 Phase-1
    scope. Stands in for Layer 9 ("Experience") of docs/architecture/01-architecture-blueprint.md
    Section 2, which has the least specification depth of any layer per the gap analysis -- the
    evidence drill-down chain implemented here (signal -&gt; feature values) is a first, narrow
    slice of that layer, not a claim that Layer 9's design work is complete.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.ewsfi</groupId>
      <artifactId>ews-schemas</artifactId>
    </dependency>
    <dependency>
      <groupId>org.ewsfi</groupId>
      <artifactId>ews-persistence-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
