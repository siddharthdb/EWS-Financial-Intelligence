  <artifactId>services</artifactId>
  <packaging>pom</packaging>
  <name>EWS Service Modules</name>

  <!--
    Module boundaries follow the logical domains in docs/architecture/01-architecture-blueprint.md
    Section 23, consolidated per that section's explicit note that these are logical boundaries,
    not a mandate for one microservice per domain. Anomaly/graph/NLP/correlation, AI-gateway/reasoning,
    model-governance and financial-statement-intelligence domains are intentionally not scaffolded as
    modules yet: they are Phase-2/3 per docs/architecture/06-gap-analysis-and-implementation-roadmap.md
    Section 7.
  -->
  <modules>
    <module>ews-ingestion-service</module>
    <module>ews-core-registry-service</module>
    <module>ews-feature-processor</module>
    <module>ews-signal-policy-engine</module>
    <module>ews-case-workflow-service</module>
    <module>ews-experience-api</module>
  </modules>
</project>
